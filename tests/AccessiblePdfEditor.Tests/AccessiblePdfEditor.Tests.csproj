<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AccessiblePdfEditor.Tests</RootNamespace>
    <AssemblyName>AccessiblePdfEditor.Tests</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AccessiblePdfEditor\AccessiblePdfEditor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      UI Automation, so the tests can inspect what a screen reader would actually see. No screen
      reader is installed here, so asserting on the automation tree is the difference between
      evidence and a guess about how NVDA behaves.
    -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

</Project>
